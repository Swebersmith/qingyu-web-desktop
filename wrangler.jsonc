{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weboss",
  "main": "worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Keep dashboard-managed D1 / Workers AI bindings and default secret retention.
  "unsafe": {
    "metadata": {
      "keep_bindings": ["d1", "ai", "secret_text", "secret_key"]
    }
  },
  "ratelimits": [
    {"name":"AI_LIMITER","namespace_id":"10420930","simple":{"limit":6,"period":60}},
    {"name":"SYNC_LIMITER","namespace_id":"10420931","simple":{"limit":60,"period":60}}
  ],
  "observability": {
    "enabled": true,
    "traces": {"enabled":true},
    "head_sampling_rate": 1
  }
}
