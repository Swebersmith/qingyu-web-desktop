{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weboss",
  "main": "worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Keep dashboard-managed D1 bindings and Wrangler's default secret retention.
  "unsafe": {
    "metadata": {
      "keep_bindings": ["d1", "secret_text", "secret_key"]
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
